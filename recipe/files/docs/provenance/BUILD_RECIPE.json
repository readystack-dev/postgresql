{
  "schema": "kitforge.build_recipe.v1",
  "slug": "postgresql",
  "image": "readystack/postgresql:18.7-CE-ubuntu24.04-r1",
  "build_method": "source-rebuild-c",
  "source": {
    "repo": "https://github.com/postgres/postgres",
    "ref": "REL_18_7",
    "builder_image": "ubuntu:24.04",
    "build_system": "autoconf-make",
    "configure": "./configure",
    "configure_flags": [
      "--prefix=/usr/local/pgsql",
      "--with-openssl",
      "--with-libxml",
      "--with-icu",
      "--with-lz4",
      "--with-zstd",
      "--with-readline",
      "--with-system-tzdata=/usr/share/zoneinfo",
      "--without-llvm"
    ],
    "build_cmds": [
      "./configure --prefix=/usr/local/pgsql --with-openssl --with-libxml --with-icu --with-lz4 --with-zstd --with-readline --without-llvm",
      "make -j\"$(nproc)\" world-bin",
      "make install-world-bin"
    ],
    "install_cmd": "make install-world-bin",
    "install_prefix": "/usr/local/pgsql",
    "build_packages": [
      "build-essential",
      "gcc",
      "make",
      "bison",
      "flex",
      "perl",
      "pkg-config",
      "libreadline-dev",
      "zlib1g-dev",
      "libssl-dev",
      "libicu-dev",
      "libxml2-dev",
      "liblz4-dev",
      "libzstd-dev",
      "ca-certificates",
      "git"
    ],
    "build_env": {
      "DEB_BUILD_OPTIONS": "nocheck"
    },
    "_note": "GIT-tree build (NOT a release tarball), so bison+flex+perl are MANDATORY (the grammar/scanner + catalog headers are generated, not committed). ./configure IS committed (no autoconf needed). world-bin builds src + config + contrib WITHOUT the documentation (no docbook/xsltproc), install-world-bin installs that same set into --prefix. The default configure keeps rpath pointed at /usr/local/pgsql/lib, so the runtime binaries find their own libpq/libpgport without LD_LIBRARY_PATH \u2014 which is WHY install_prefix must be IDENTICAL in the build and runtime stages (/usr/local/pgsql in both). --with-system-tzdata uses the OS tzdata (kept fresh by the runtime tzdata package) instead of bundling a stale copy. JIT is --without-llvm on purpose (LLVM is the single largest avoidable dependency + CVE surface). No PL languages, NLS, GSSAPI or LDAP (all opt-in, all OFF) to keep the attack surface minimal.",
    "source_date_epoch": 1794522143,
    "source_date_epoch_provenance": "the time release 18.7-CE-ubuntu24.04-r1 was cut (2026-11-12T22:22:23Z), by scripts/retarget.py: ReadyStack dates an image by when its release was packaged (owner 2026-11-10), recorded here once and used by every rebuild of the release; it builds upstream commit f5c41f6681c9, dated 2026-11-09T20:09:29Z (source.commit_epoch).",
    "commit": "f5c41f6681c910b3f69951bf6fb97c6d74605d25",
    "source_date_epoch_basis": "release-cut",
    "commit_epoch": 1794254969
  },
  "binaries_from_source": null,
  "runtime_packages": [
    "base-files",
    "base-passwd",
    "bash",
    "ca-certificates",
    "coreutils",
    "dash",
    "gcc-14-base",
    "libacl1",
    "libc-bin",
    "libc6",
    "libgcc-s1",
    "libicu74",
    "liblz4-1",
    "liblzma5",
    "libpcre2-8-0",
    "libreadline8t64",
    "libselinux1",
    "libssl3t64",
    "libstdc++6",
    "libtinfo6",
    "libxml2",
    "libzstd1",
    "openssl",
    "readline-common",
    "tar",
    "tzdata",
    "zlib1g"
  ],
  "runtime_base": {
    "kind": "chisel",
    "shell": true,
    "tools": [
      "bash",
      "mkdir",
      "mktemp",
      "chmod",
      "tar"
    ],
    "slices": [
      "libicu74_libs",
      "libssl3t64_libs",
      "zlib1g_libs",
      "libzstd1_libs",
      "libxml2_libs",
      "libtinfo6_libs",
      "libstdc++6_libs",
      "libreadline8t64_libs",
      "liblzma5_libs",
      "liblz4-1_libs",
      "libgcc-s1_libs",
      "libc-bin_locale"
    ],
    "provides": [
      "postgres",
      "initdb",
      "pg_ctl",
      "psql",
      "pg_isready",
      "pg_dump",
      "pg_dumpall",
      "pg_restore",
      "createdb",
      "dropdb",
      "pg_basebackup",
      "pg_upgrade",
      "vacuumdb",
      "reindexdb",
      "clusterdb",
      "createuser",
      "dropuser"
    ],
    "rootfs_run": [
      "chmod 1777 \"$ROOT/docker-entrypoint-initdb.d\"",
      "ln -s /usr/share/zoneinfo/Etc/UTC \"$ROOT/etc/localtime\""
    ],
    "packages": "vendored/chisel/packages.tsv"
  }
}